{
  "name": "@xieyuheng/geometer",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "author": "Xie Yuheng",
  "type": "module",
  "repository": "github:xieyuheng/geometer",
  "files": [
    "src",
    "lib"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test:js": "test-runner test node 'lib/**/*.test.js'",
    "test:snapshot": "test-runner snapshot node 'lib/**/*.snapshot.js' --extern snapshot",
    "test": "npm run test:js && npm run test:snapshot",
    "format": "prettier src --write"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@xieyuheng/test-runner": "^0.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "^5.6.3"
  }
}
